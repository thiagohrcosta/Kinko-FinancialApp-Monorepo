# URL do backend Rails acessada pelo servidor Next.js (BFF).
# Em Docker Compose use http://backend:3000
API_BASE_URL=http://localhost:3000

# Chave publicável do Stripe (pk_test_...) — mesma conta do STRIPE_SECRET_KEY do backend.
# Lida em tempo de requisição pelo servidor; sem ela a tela de depósito mostra um aviso.
STRIPE_PUBLISHABLE_KEY=
