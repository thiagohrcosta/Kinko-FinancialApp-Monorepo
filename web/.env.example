# Rails backend URL used by the Next.js server (BFF).
# With Docker Compose use http://backend:3000
API_BASE_URL=http://localhost:3000

# Stripe publishable key (pk_test_...) — same Stripe account as the backend's STRIPE_SECRET_KEY.
# Read by the server at request time; without it the deposit page shows a notice.
STRIPE_PUBLISHABLE_KEY=
